# Database - Prisma / Neon
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
DIRECT_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Auth
JWT_SECRET=replace-with-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=7d

# Password hashing
SALT_ROUNDS=12

# Email / SMTP (Gmail App Password required, not your normal password)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password
EMAIL_FROM="TapAl" <your-email@gmail.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

# Frontend / CORS (comma separated for CORS_ORIGINS)
FRONTEND_URL=http://localhost:5500
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Server
PORT=5000
NODE_ENV=development

# Rate limit / monitoring
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
SENTRY_DSN=
LOG_LEVEL=info
